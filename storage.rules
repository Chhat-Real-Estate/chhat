rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────────────
    // GLOBAL: default deny
    // ──────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────
    // LISTING PHOTOS
    // - Path: listings/{userId}/{filename}
    // - Read:   koi bhi authenticated user (public listing photos)
    // - Create: sirf owner (auth.uid == userId), max 5MB, image only
    // - Delete: sirf owner (auth.uid == userId)
    // - Update: nahi (delete + re-upload karo)
    // ──────────────────────────────────────────────
    match /listings/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024  // 5MB max
                    && request.resource.contentType.matches('image/.*');

      allow update: if false;

      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}
